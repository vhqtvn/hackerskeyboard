<?xml version="1.0" encoding="utf-8"?>
<!--
  AYN Thor deck keyboard: based on kbd_compact (11 columns, big keys for thumb
  typing) but with the compact "extension" symbol row made permanent so every
  terminal/programming symbol is on the surface (no hidden layer), and F1-F12
  folded onto the blue Fn (Fn2) layer over the number / - / = keys.
-->
<Keyboard
    xmlns:android="http://schemas.android.com/apk/res-auto"
    android:keyWidth="9.09090909%p"
    android:horizontalGap="0px"
    android:verticalGap="0px"
    android:verticalPad="@dimen/key_vertical_pad_compact"
    android:layoutRows="6"
    android:layoutColumns="11"
 >
    <!-- Symbol row (always visible). Esc top-left = deliberate, low-mistouch.
         Shift labels expose the upper glyphs, PC-keyboard style. -->
    <Row>
        <Key android:codes="@integer/key_escape" android:keyLabel="Esc" android:isModifier="true"
             android:keyWidth="10%p" android:keyEdgeFlags="left" />
        <Key android:keyLabel="`" android:shiftLabel="~" android:isRepeatable="true"
             android:keyWidth="8%p" />
        <Key android:keyLabel="-" android:shiftLabel="_" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f11" android:fn2Label="F11" android:keyWidth="8%p" />
        <Key android:keyLabel="\\" android:shiftLabel="|" android:isRepeatable="true"
             android:keyWidth="8%p" />
        <Key android:keyLabel=";" android:shiftLabel=":" android:isRepeatable="true"
             android:keyWidth="8%p" />
        <Key android:keyLabel="=" android:shiftLabel="+" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f12" android:fn2Label="F12" android:keyWidth="8%p" />
        <Key android:keyLabel="[" android:shiftLabel="{" android:isRepeatable="true"
             android:keyWidth="8%p" />
        <Key android:keyLabel="]" android:shiftLabel="}" android:isRepeatable="true"
             android:keyWidth="8%p" />
        <Key android:codes="@integer/key_home" android:isModifier="true" android:keyLabel="Home"
             android:keyWidth="12%p" />
        <Key android:codes="@integer/key_end" android:isModifier="true" android:keyLabel="End"
             android:keyWidth="12%p" />
        <Key android:codes="@integer/key_forward_del" android:isModifier="true"
             android:keyLabel="Del" android:keyWidth="10%p" android:keyEdgeFlags="right" />
    </Row>

    <!-- Numbers. Shift = ! @ # ... ; blue Fn = F1..F10. -->
    <Row>
        <Key android:keyLabel="1" android:shiftLabel="!" android:keyEdgeFlags="left"
             android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f1" android:fn2Label="F1"
             android:keyWidth="7.09090909%p" />
        <Key android:keyLabel="2" android:shiftLabel="\@" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f2" android:fn2Label="F2" />
        <Key android:keyLabel="3" android:shiftLabel="#" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f3" android:fn2Label="F3" />
        <Key android:keyLabel="4" android:shiftLabel="$" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f4" android:fn2Label="F4" />
        <Key android:keyLabel="5" android:shiftLabel="%" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f5" android:fn2Label="F5" />
        <Key android:keyLabel="6" android:shiftLabel="^" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f6" android:fn2Label="F6" />
        <Key android:keyLabel="7" android:shiftLabel="&amp;" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f7" android:fn2Label="F7" />
        <Key android:keyLabel="8" android:shiftLabel="*" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f8" android:fn2Label="F8" />
        <Key android:keyLabel="9" android:shiftLabel="(" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f9" android:fn2Label="F9" />
        <Key android:keyLabel="0" android:shiftLabel=")" android:isRepeatable="true"
             android:fn2Codes="@integer/key_fkey_f10" android:fn2Label="F10" />
        <Key android:codes="@integer/key_delete"
             android:keyWidth="11.09090909%p"
             android:keyIcon="@drawable/sym_keyboard_delete"
             android:iconPreview="@drawable/sym_keyboard_feedback_delete"
             android:isModifier="true" android:isRepeatable="true"
             android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:keyLabel="q" android:keyEdgeFlags="left" />
        <Key android:keyLabel="w" />
        <Key android:keyLabel="e" />
        <Key android:keyLabel="r" />
        <Key android:keyLabel="t" />
        <Key android:keyLabel="y" />
        <Key android:keyLabel="u"
             android:fn2Codes="@integer/key_page_up" android:fn2Label="PgUp" />
        <Key android:keyLabel="i" />
        <Key android:keyLabel="o" />
        <Key android:keyLabel="p" />
        <Key android:keyLabel="'" android:shiftLabel="&quot;" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:keyLabel="a" android:horizontalGap="4.54545454%p" android:keyEdgeFlags="left" />
        <Key android:keyLabel="s" />
        <Key android:keyLabel="d"
             android:fn2Codes="@integer/key_page_down" android:fn2Label="PgDn" />
        <Key android:keyLabel="f" />
        <Key android:keyLabel="g" />
        <Key android:keyLabel="h"
             android:fn2Codes="@integer/key_dpad_left" android:fn2Label="&#x2190;" />
        <Key android:keyLabel="j"
             android:fn2Codes="@integer/key_dpad_down" android:fn2Label="&#x2193;" />
        <Key android:keyLabel="k"
             android:fn2Codes="@integer/key_dpad_up" android:fn2Label="&#x2191;" />
        <Key android:keyLabel="l"
             android:fn2Codes="@integer/key_dpad_right" android:fn2Label="&#x2192;" />
        <Key android:codes="@integer/key_return"
             android:keyIcon="@drawable/sym_keyboard_return"
             android:iconPreview="@drawable/sym_keyboard_feedback_return"
             android:isModifier="true"
             android:keyWidth="13.6363636%p"
             android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="@integer/key_shift_left"
             android:keyWidth="11.09090909%p"
             android:keyIcon="@drawable/sym_keyboard_shift"
             android:iconPreview="@drawable/sym_keyboard_feedback_shift"
             android:isModifier="true" android:isSticky="true"
             android:keyEdgeFlags="left" />
        <Key android:keyLabel="z" />
        <Key android:keyLabel="x" />
        <Key android:keyLabel="c" />
        <Key android:keyLabel="v" />
        <Key android:keyLabel="b" />
        <Key android:keyLabel="n" />
        <Key android:keyLabel="m" />
        <Key android:keyLabel="," android:shiftLabel="&lt;" />
        <Key android:keyLabel="." android:shiftLabel="&gt;" />
        <Key android:keyLabel="/" android:shiftLabel="\?"
             android:keyWidth="7.09090909%p" android:keyEdgeFlags="right" />
    </Row>

    <!-- Modifiers + wide space. Ctrl/Alt/Shift reachable on both sides (sticky: tap
         to latch, then tap a key -> chord, e.g. Ctrl+Z), so no awkward hold. Arrows
         moved to the vim Fn layer (Fn+hjkl); the reclaimed room widens the space bar
         and puts right-hand Alt + Shift for two-thumb modifier access. -->
    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="@integer/key_ctrl_left" android:keyLabel="Ctrl"
             android:isModifier="true" android:isSticky="true"
             android:keyWidth="10%p" android:keyEdgeFlags="left" />
        <Key android:codes="@integer/key_fn_2" android:keyLabel="Fn"
             android:isModifier="true" android:isSticky="true" android:keyWidth="10%p" />
        <Key android:codes="@integer/key_alt_left" android:keyLabel="Alt"
             android:isModifier="true" android:isSticky="true" android:keyWidth="10%p" />
        <Key android:codes="@integer/key_tab"
             android:keyIcon="@drawable/sym_keyboard_tab"
             android:iconPreview="@drawable/sym_keyboard_feedback_tab"
             android:isModifier="true" android:keyWidth="10%p" />
        <Key android:codes="@integer/key_space"
             android:keyIcon="@drawable/sym_keyboard_space"
             android:iconPreview="@drawable/sym_keyboard_feedback_space"
             android:isModifier="true" android:keyWidth="30%p" />
        <Key android:codes="@integer/key_alt_right" android:keyLabel="Alt"
             android:isModifier="true" android:isSticky="true" android:keyWidth="10%p" />
        <Key android:codes="@integer/key_shift_right" android:keyLabel="Shift"
             android:isModifier="true" android:isSticky="true" android:keyWidth="10%p" />
        <Key android:codes="@integer/key_ctrl_right" android:keyLabel="Ctrl"
             android:isModifier="true" android:isSticky="true"
             android:keyWidth="10%p" android:keyEdgeFlags="right" />
    </Row>
</Keyboard>
